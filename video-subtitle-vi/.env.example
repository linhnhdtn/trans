# ---- Nhận dạng giọng nói ----
WHISPER_MODEL=large-v3        # large-v3 | medium | small (nhỏ hơn = nhanh hơn, kém chính xác hơn)
WHISPER_DEVICE=cuda           # cuda | cpu
# WHISPER_COMPUTE=float16     # GPU: float16 | CPU: int8

# ---- Dịch ----
TRANSLATOR=openai             # openai (DeepSeek/OpenAI/Qwen...) | claude | ollama
# API chuẩn OpenAI – mặc định DeepSeek
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# Claude (TRANSLATOR=claude)
ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-haiku-5-5 # đổi sang claude-sonnet-5-5 nếu cần chất lượng cao hơn
# Ollama (TRANSLATOR=ollama, dịch nội bộ)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
TRANSLATE_BATCH=30

# ---- Hệ thống ----
SUB_FONT=Noto Sans
MAX_UPLOAD_MB=2048
WORKERS=1

# ---- Tải video (TikTok, Douyin, Facebook, YouTube) ----
# Douyin hay đòi cookie: xuất cookies.txt từ trình duyệt (extension "Get cookies.txt"), đặt vào data/
# YTDLP_COOKIES=/data/cookies.txt

# ---- Giọng đọc AI (edge-tts) – bật/tắt theo từng video trên giao diện, mặc định tắt ----
TTS_BG_VOLUME=0.15            # âm lượng tiếng gốc khi có giọng đọc (0 = tắt hẳn, 1 = giữ nguyên)
